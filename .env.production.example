# Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Server Configuration
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Database Configuration
# IMPORTANT: Change the password!
DATABASE_URL=postgresql://wordsto:CHANGE_THIS_PASSWORD@postgres:5432/wordsto_link
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wordsto_link
DB_USER=wordsto
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# Application Settings
BASE_URL=https://wordsto.link
SHORT_URL_BASE=https://wordsto.link
FRONTEND_URL=https://wordsto.link
MAX_KEYWORDS_FREE=10
MAX_KEYWORDS_PERSONAL=100
MAX_KEYWORDS_BUSINESS=1000
MAX_KEYWORDS_ENTERPRISE=10000

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_PRODUCTION_API_KEY
EMAIL_FROM=WordsTo.Link <noreply@wordsto.link>
FORCE_EMAIL_SEND=true

# Optional: Stripe Configuration
# STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Optional: Clerk Authentication (if using)
# CLERK_SECRET_KEY=your-clerk-secret-key
# CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret

# Security Settings
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=https://wordsto.link,https://www.wordsto.link

# Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOGTAIL_TOKEN=your-logtail-token